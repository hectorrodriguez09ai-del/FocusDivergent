    <string name="permission_overlay_description">Permite mostrar la pantalla de pausa encima de una app cuando se agota el tiempo que tú has decidido.</string>

    <string name="permission_usage_stats_title">Acceso al uso de apps</string>
    <string name="permission_usage_stats_description">Permite saber cuánto tiempo llevas en cada app para aplicar tus límites diarios. Estos datos no salen del dispositivo.</string>

    <string name="permission_accessibility_title">Servicio de accesibilidad</string>
    <string name="permission_accessibility_description">Permite detectar qué app está en pantalla para aplicar la pausa al instante. No lee lo que escribes ni el contenido de la pantalla.</string>

    <string name="permission_exact_alarm_title">Avisos puntuales (recomendado)</string>
    <string name="permission_exact_alarm_description">Permite avisarte justo 10 minutos antes de una Obligación, incluso con el móvil en reposo. Sin este permiso el aviso puede retrasarse unos minutos. No es necesario para usar la protección.</string>

    <string name="battery_title">Que Android no pare la protección (recomendado)</string>
    <string name="battery_description">Para ahorrar batería, algunos móviles suspenden las apps que no estás usando, y eso podría detener la protección. Excluir FocusDivergent evita que pase. No es necesario para usar la app.</string>
    <string name="battery_steps_standard">Pulsa el botón, busca FocusDivergent en la lista y elige «No optimizar» (o «Sin restricciones»).</string>
    <string name="battery_standard_done">Ajuste estándar de Android: listo ✓</string>
    <string name="battery_open_settings">Abrir ajustes de batería</string>
    <string name="battery_steps_samsung">En Samsung hay un segundo ajuste propio: abre Ajustes &gt; Batería (o Cuidado del dispositivo) &gt; Límites de uso en segundo plano, entra en «Apps que nunca se suspenden» y añade FocusDivergent. Comprueba también que no esté en «Apps en suspensión» ni en «Apps en suspensión profunda». Los nombres pueden variar según la versión de One UI.</string>

    <string name="permission_grant_action">Conceder</string>
    <string name="permission_granted">Listo ✓</string>
    <string name="permissions_all_granted">Todo listo. Ya puedes empezar.</string>
    <string name="permissions_restricted_settings_hint">¿El interruptor de accesibilidad aparece desactivado? Si instalaste la app fuera de una tienda, abre Ajustes &gt; Apps &gt; FocusDivergent, toca el menú ⋮ y elige «Permitir ajustes restringidos».</string>

